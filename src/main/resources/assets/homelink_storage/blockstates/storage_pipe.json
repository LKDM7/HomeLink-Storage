{
  "multipart": [
    {"apply": {"model": "homelink_storage:block/storage_pipe_core"}},
    {"when": {"north": "none"}, "apply": {"model": "homelink_storage:block/storage_pipe_cap"}},
    {"when": {"north": "pipe|controller|container"}, "apply": {"model": "homelink_storage:block/storage_pipe_arm"}},
    {"when": {"north": "controller|container"}, "apply": {"model": "homelink_storage:block/storage_pipe_connector"}},
    {"when": {"east": "none"}, "apply": {"model": "homelink_storage:block/storage_pipe_cap", "y": 90}},
    {"when": {"east": "pipe|controller|container"}, "apply": {"model": "homelink_storage:block/storage_pipe_arm", "y": 90}},
    {"when": {"east": "controller|container"}, "apply": {"model": "homelink_storage:block/storage_pipe_connector", "y": 90}},
    {"when": {"south": "none"}, "apply": {"model": "homelink_storage:block/storage_pipe_cap", "y": 180}},
    {"when": {"south": "pipe|controller|container"}, "apply": {"model": "homelink_storage:block/storage_pipe_arm", "y": 180}},
    {"when": {"south": "controller|container"}, "apply": {"model": "homelink_storage:block/storage_pipe_connector", "y": 180}},
    {"when": {"west": "none"}, "apply": {"model": "homelink_storage:block/storage_pipe_cap", "y": 270}},
    {"when": {"west": "pipe|controller|container"}, "apply": {"model": "homelink_storage:block/storage_pipe_arm", "y": 270}},
    {"when": {"west": "controller|container"}, "apply": {"model": "homelink_storage:block/storage_pipe_connector", "y": 270}},
    {"when": {"up": "none"}, "apply": {"model": "homelink_storage:block/storage_pipe_cap", "x": 270}},
    {"when": {"up": "pipe|controller|container"}, "apply": {"model": "homelink_storage:block/storage_pipe_arm", "x": 270}},
    {"when": {"up": "controller|container"}, "apply": {"model": "homelink_storage:block/storage_pipe_connector", "x": 270}},
    {"when": {"down": "none"}, "apply": {"model": "homelink_storage:block/storage_pipe_cap", "x": 90}},
    {"when": {"down": "pipe|controller|container"}, "apply": {"model": "homelink_storage:block/storage_pipe_arm", "x": 90}},
    {"when": {"down": "controller|container"}, "apply": {"model": "homelink_storage:block/storage_pipe_connector", "x": 90}}
  ]
}
